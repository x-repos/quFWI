\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Schematic of the finite-basis classical-quantum hybrid architecture, combining classical neural networks and quantum circuits with physics-informed constraints. $\mathcal  {N}$ denotes classical networks, $\mathcal  {Q}$ quantum circuits, $\phi $ the predicted wavefield, $v$ the inverted velocity, and $\mathcal  {R}$ the physics- and data-based residuals.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:hybrid_arch}{{1}{4}{Schematic of the finite-basis classical-quantum hybrid architecture, combining classical neural networks and quantum circuits with physics-informed constraints. $\mathcal {N}$ denotes classical networks, $\mathcal {Q}$ quantum circuits, $\phi $ the predicted wavefield, $v$ the inverted velocity, and $\mathcal {R}$ the physics- and data-based residuals}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Multilayer PQC $\mathcal  {Q}$. Each classical input feature $x_i$ is angle-encoded via an $R_y(\beta _i\, x_i)$ rotation (encoding layer, grey), where $\beta _i$ is a trainable scaling parameter. Variational layers of single-qubit rotations $R_x$, $R_y$, $R_z$ followed by a linear CNOT ladder are repeated $N_Q$ times (grey block). Each qubit is measured in the Pauli-$Z$ basis, and the outputs are averaged to yield a scalar in $[-1, 1]$.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:pqc_architecture}{{2}{4}{Multilayer PQC $\mathcal {Q}$. Each classical input feature $x_i$ is angle-encoded via an $R_y(\beta _i\, x_i)$ rotation (encoding layer, grey), where $\beta _i$ is a trainable scaling parameter. Variational layers of single-qubit rotations $R_x$, $R_y$, $R_z$ followed by a linear CNOT ladder are repeated $N_Q$ times (grey block). Each qubit is measured in the Pauli-$Z$ basis, and the outputs are averaged to yield a scalar in $[-1, 1]$}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Network configurations for the anomaly benchmark. $\mathcal  {Q}(n_q^{\times n_L})$ denotes a PQC with $n_q$ qubits and $n_L$ layers. Subdomain decomposition ($5\!\times \!3\!\times \!5$, overlap 0.35) applies to the wavefield network $\phi $; the velocity network $v$ is a single global network. Loss weights: $\lambda _\text  {PDE}\!=\!0.1$, $\lambda _\text  {IC}\!=\!1.0$, $\lambda _\text  {seis}\!=\!1.0$, $\lambda _\text  {BC}\!=\!0.1$. Learning rate $10^{-4}$. See Supplementary Table~S1 for the full hyperparameter variant sweep.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:hyperparams_main}{{1}{5}{Network configurations for the anomaly benchmark. $\mathcal {Q}(n_q^{\times n_L})$ denotes a PQC with $n_q$ qubits and $n_L$ layers. Subdomain decomposition ($5\!\times \!3\!\times \!5$, overlap 0.35) applies to the wavefield network $\phi $; the velocity network $v$ is a single global network. Loss weights: $\lambda _\text {PDE}\!=\!0.1$, $\lambda _\text {IC}\!=\!1.0$, $\lambda _\text {seis}\!=\!1.0$, $\lambda _\text {BC}\!=\!0.1$. Learning rate $10^{-4}$. See Supplementary Table~S1 for the full hyperparameter variant sweep}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Anomaly benchmark inversion and convergence. (a) True velocity model used for the SPECFEM2D forward simulation, with source (red star) and receiver array (green triangles). (b) Initial homogeneous velocity model. (c) Inverted velocity model from the quantum hybrid FBPINN at $65{,}000$ training iterations. (d) L1 velocity error versus training iteration for the classical FBPINN baseline (blue), the quantum hybrid (red markers labelled 65k), and 15 classical hyperparameter variants (thin coloured lines). The quantum hybrid reaches a lower L1 error than any classical variant in approximately $8\times $ fewer training iterations.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:anomaly}{{3}{6}{Anomaly benchmark inversion and convergence. (a) True velocity model used for the SPECFEM2D forward simulation, with source (red star) and receiver array (green triangles). (b) Initial homogeneous velocity model. (c) Inverted velocity model from the quantum hybrid FBPINN at $65{,}000$ training iterations. (d) L1 velocity error versus training iteration for the classical FBPINN baseline (blue), the quantum hybrid (red markers labelled 65k), and 15 classical hyperparameter variants (thin coloured lines). The quantum hybrid reaches a lower L1 error than any classical variant in approximately $8\times $ fewer training iterations}{figure.3}{}}
